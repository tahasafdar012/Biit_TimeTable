# Copy this file to .env and set a strong password:  cp .env.example .env
# (On Render, set these in the dashboard under Environment instead.)
ADMIN_PASSWORD=change-me

# Where the uploaded timetable is saved. Pick one:
#  - MongoDB (Render free plan, MongoDB Atlas free cluster):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#  - Files (default: server/data), or a disk path:
# DATA_DIR=/var/data

# PORT=5000
